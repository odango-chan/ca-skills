{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:response-result:update-sm-context:v1",
  "title": "Typed Step 17 UpdateSMContext response result",
  "description": "Internal typed Producer output for the TS 23.502 V19.5.0 Step 15–17 reference flow. It includes the Step 16 branch completion evidence and the response representation selector; only mapped SmContextUpdatedData fields are serialized on the wire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "procedureOutcome",
    "step16Outcome",
    "responseRepresentation"
  ],
  "properties": {
    "procedureOutcome": {
      "enum": [
        "n2-user-plane-setup-succeeded",
        "n2-user-plane-setup-failed"
      ]
    },
    "step16Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n4Action",
        "udmRegistration"
      ],
      "properties": {
        "n4Action": {
          "enum": [
            "session-modified",
            "session-released"
          ]
        },
        "udmRegistration": {
          "enum": [
            "completed",
            "not-required",
            "skipped"
          ]
        }
      }
    },
    "responseRepresentation": {
      "enum": [
        "json",
        "multipart",
        "no-content"
      ]
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "n1SmMessage": {
      "$ref": "urn:example:response:binary-content-reference:v1"
    },
    "n2SmInformation": {
      "$ref": "urn:example:response:binary-content-reference:v1"
    },
    "n2SmInfoType": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "procedureOutcome": {
            "const": "n2-user-plane-setup-failed"
          }
        },
        "required": [
          "procedureOutcome"
        ]
      },
      "then": {
        "required": [
          "n1SmMessage"
        ],
        "properties": {
          "responseRepresentation": {
            "const": "multipart"
          },
          "step16Outcome": {
            "properties": {
              "n4Action": {
                "const": "session-released"
              },
              "udmRegistration": {
                "const": "skipped"
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "n2SmInformation"
              ]
            },
            {
              "required": [
                "n2SmInfoType"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "procedureOutcome": {
            "const": "n2-user-plane-setup-succeeded"
          }
        },
        "required": [
          "procedureOutcome"
        ]
      },
      "then": {
        "properties": {
          "step16Outcome": {
            "properties": {
              "n4Action": {
                "const": "session-modified"
              },
              "udmRegistration": {
                "enum": [
                  "completed",
                  "not-required"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "n1SmMessage"
        ]
      },
      "then": {
        "properties": {
          "responseRepresentation": {
            "const": "multipart"
          },
          "n1SmMessage": {
            "properties": {
              "mediaType": {
                "const": "application/vnd.3gpp.5gnas"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "n2SmInformation"
        ]
      },
      "then": {
        "required": [
          "n2SmInfoType"
        ],
        "properties": {
          "responseRepresentation": {
            "const": "multipart"
          },
          "n2SmInformation": {
            "properties": {
              "mediaType": {
                "const": "application/vnd.3gpp.ngap"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "n2SmInfoType"
        ]
      },
      "then": {
        "required": [
          "n2SmInformation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "responseRepresentation": {
            "const": "json"
          }
        },
        "required": [
          "responseRepresentation"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "n1SmMessage"
              ]
            },
            {
              "required": [
                "n2SmInformation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "responseRepresentation": {
            "const": "multipart"
          }
        },
        "required": [
          "responseRepresentation"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "n1SmMessage"
            ]
          },
          {
            "required": [
              "n2SmInformation"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "responseRepresentation": {
            "const": "no-content"
          }
        },
        "required": [
          "responseRepresentation"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "cause"
              ]
            },
            {
              "required": [
                "n1SmMessage"
              ]
            },
            {
              "required": [
                "n2SmInformation"
              ]
            },
            {
              "required": [
                "n2SmInfoType"
              ]
            }
          ]
        }
      }
    }
  ]
}
